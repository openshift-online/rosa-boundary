  "claims": [
    {
      "id": "claim_c265734120974bb98f13bd65ad8709ae",
      "statement": "Boundary federates two distinct OIDC trust relationships — GitHub Actions for CI/content publishing and Keycloak (primary/stage/prod) for SREs and the Lambda invoker — into the account-global shared-iam Terraform module, which defines identity and trust only; the matching AWS permissions are attached separately by regional Terraform roots that look the roles up by name via the regional_iam_contract output.",
      "evidence": [
        {
          "resource": "repo://deploy/account/main.tf#L40-L77",
          "version": "repo-lines-v1:sha256:34afb635ecd224abf60326dfb194dc72dbdda31a8c2160c585e7b10887f4550c:"
        },
        {
          "resource": "repo://deploy/account/modules/shared-iam/content-publishing.tf#L1-L16",
          "version": "repo-lines-v1:sha256:e1cb5573fc7ce43964404b061064648b0e8b2e880f4d9df8ebed950146f4424a:"
        },
        {
