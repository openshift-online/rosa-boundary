    {
      "id": "claim_933818b06d2d4e9dbae3cea870d68a71",
      "statement": "Bedrock model agreements are approved via an explicit model_id-to-offer_id manifest; the actual offer_token is looked up from the live aws_bedrock_foundation_model_agreement_offers data source at plan time, validated against the approved offer_id via a precondition, and then ignored on subsequent changes via lifecycle.ignore_changes, since AWS can rotate the token without changing the approved offer.",
      "evidence": [
        {
          "resource": "repo://deploy/account/bedrock-model-agreements.tf#L1-L39",
          "version": "repo-lines-v1:sha256:8978a2d582644b11cb9e81e59d0f0652756e268443eef784678ba8e76f00326c:"
