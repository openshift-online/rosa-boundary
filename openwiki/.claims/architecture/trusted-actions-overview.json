    {
      "id": "claim_c48eb605ec8e40829af97c72045f8c26",
      "statement": "Trusted Actions splits its codebase into two layers meeting at a persisted execution row: a synchronous request-handling layer (router -> middleware -> handlers -> store) and an asynchronous action-execution layer (worker pool -> runner -> executor -> action -> backplane -> cluster/cloud provider).",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/ARCHITECTURE.md#L31-L59",
          "version": "repo-lines-v1:sha256:953abe3242680028073e413d539eb45c5ae03e75aca654d1a22ec67979064b1d:"
        }
      ]
    },
    {
      "id": "claim_fac7448b1fb54bbebaca64e117ebc196",
      "statement": "cmd/server/main.go is the composition root: it loads config, wires authn/authz middleware (real OCM-backed or mock depending on ROSA_TA_AUTH), constructs the Backplane client provider (real Backplane-CLI-backed or kubeconfig-backed for local dev), builds the catalog, and starts the HTTP server and worker pool together.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/cmd/server/main.go#L70-L250",
          "version": "repo-lines-v1:sha256:1616553b4c6c7445e150e803d8b6926802809792dbd63e95ff535b6b06f88c90:"
        }
