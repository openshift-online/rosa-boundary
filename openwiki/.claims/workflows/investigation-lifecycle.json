    {
      "id": "claim_b87f0e13df2d4475b97c9336a9cb3698",
      "statement": "An investigation workspace can outlive its last task, so closing it is a request to the close service, not direct CLI deletion: `runCloseInvestigation` only previews and submits the request; the CLI no longer stops tasks, deregisters task definitions, or deletes the access point itself, so an 'accepted' close is not yet a 'closed' one.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/close_investigation.go#L74-L98",
          "version": "repo-lines-v1:sha256:b58ef38f59066d62c4f4ebb94e9276534da3ad818b2426776b9bdd11c123a974:"
        }
      ]
    },
    {
      "id": "claim_87bf9c76d9ba4c9bac5927f9db77fb29",
      "statement": "`session create`'s auto-connect step and `session join` share the same `connectToSession` helper, which waits for the task to reach RUNNING, polls the container's ECS Exec agent for up to 30 seconds, and only then opens the SSM session; `session join` additionally requires the authenticated ID token's subject to match the task's recorded creator subject before admission is checked.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/join_session.go#L208-L271",
          "version": "repo-lines-v1:sha256:6c0bf9b746f12deb8b1d18e4af2e1eda609552110c4e871db87fab97b3a15554:"
