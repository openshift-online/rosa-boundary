    {
      "id": "claim_48739654106849cd894c2057eb5450d1",
      "statement": "Trusted Actions' contributor documentation (TESTING.md, CONTRIBUTING.md, docs/adding-a-trusted-action.md) states patch coverage must be >= 80% on all PRs, enforced by Codecov, with internal/handlers/ and internal/config/ called out as the primary coverage targets; however the actual components/trusted-actions/codecov.yml configuration currently sets coverage.status.patch.default.target to 50% (its own header comment says \"Enforces >=50% patch coverage on all PRs\"), so the mechanically enforced Codecov gate is lower than the documented 80% bar.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/CONTRIBUTING.md#L25-L25",
          "version": "repo-lines-v1:sha256:f8ee1d55ee5d0054692e17d1f8aa57bc6d55ed0ba1baf5eac072f6ce2226d53e:"
