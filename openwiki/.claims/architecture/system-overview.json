    {
      "id": "claim_c8f310c311ac48c29b5b71786204d057",
      "statement": "Reaping a stale investigation deletes, in order, the EFS directory contents (after a mandatory S3 backup that blocks deletion if it fails or S3_AUDIT_BUCKET is unset), then the EFS access point (only if directory deletion succeeded, since the access point's tags are the only way to locate the directory), and finally deregisters any ECS task definitions whose family matches the investigation's {TASK_DEFINITION_FAMILY}-{cluster_id}-{investigation_id}-<timestamp> pattern, with task-definition deregistration attempted regardless of the earlier steps' success.",
      "evidence": [
        {
          "resource": "repo://lambda/reap-investigations/handler.py#L464-L519",
          "version": "repo-lines-v1:sha256:6b27154debaff3606aa185d82479e9ad6c7143e1b15a69b1f74c9c17f0756ce8:"
