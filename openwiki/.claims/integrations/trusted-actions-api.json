    {
      "id": "claim_2ae417d36a604f27bfb62bedd3fd1867",
      "statement": "internal/backplane.ClientProvider is an interface (GetClient for a dynamic Kubernetes client, GetPodExecutor for exec operations) with two implementations selected at server startup: BackplaneProvider, which authenticates to Backplane via an OCM SDK client-credentials connection, requests RBAC-scoped access per clusterID/actionName, and pins the resolved proxy origin to the configured Backplane base URL; and KubeconfigProvider, a local-dev fallback selected when cfg.Kubeconfig is set, which builds clients directly from a kubeconfig file and explicitly ignores supplied RBAC rules.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/cmd/server/main.go#L223-L249",
          "version": "repo-lines-v1:sha256:095be56f5fd1e8628c20fe699042122d85d7be0cf0451c8a2d5475ad7c058e6f:"
