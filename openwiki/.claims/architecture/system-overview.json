    {
      "id": "claim_14d12e3b282c4903a7521cc73447cd4e",
      "statement": "The create-investigation Lambda's register_investigation_task_definition registers a per-investigation ECS task definition that replaces the EFS home volume with the investigation's access point, strips and re-adds task-scoped (non-EFS) overlay volumes for the OCM config and kubeconfig credential paths using path-traversal-safe protected_mount_path checks, and injects a Secrets Manager kubeconfig reference into the kube-proxy sidecar's secrets.",
      "evidence": [
        {
          "resource": "repo://lambda/create-investigation/handler.py#L518-L684",
