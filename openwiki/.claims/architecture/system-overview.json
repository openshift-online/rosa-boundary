    {
      "id": "claim_4a29e57bd92b4c159d562b709fa8ea0f",
      "statement": "For reap-investigations, a matching RUNNING task prevents staleness; with no matching running task, an investigation is stale when its access point's CreatedAt age is strictly greater than GRACE_PERIOD_HOURS, or when CreatedAt is missing and treated as legacy state. This is creation age rather than idle duration, and a final startedBy-based running-task check must pass before cleanup.",
      "evidence": [
        {
          "resource": "repo://lambda/reap-investigations/handler.py#L204-L223",
          "version": "repo-lines-v1:sha256:ffd713315b78cd081da97f65ed8a3bafe54607a6e373dab98f9f8e667f7ca9bc:"
