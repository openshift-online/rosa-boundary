{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "enabledManagers": [
    "gomod",
    "pep621",
    "terraform",
    "pre-commit",
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned backplane-tools GitHub release",
      "managerFilePatterns": ["/^Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=openshift/backplane-tools\\s+ARG BACKPLANE_TOOLS_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "openshift/backplane-tools",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Review Python updates while validating Mintmaker coverage before retiring Dependabot",
      "matchManagers": ["pep621"],
      "automerge": false
    },
    {
      "description": "Group non-major Python dependency updates for the uv-locked Lambda",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "python dependencies"
    },
    {
      "description": "Group all Go module patch/minor updates, including AWS SDK modules, into a single PR",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "gomod dependencies"
    },
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
