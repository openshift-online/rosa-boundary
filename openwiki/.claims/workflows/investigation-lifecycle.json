    {
      "id": "claim_3a8694ef3164419c870da3c662b3bc6c",
      "statement": "Before stopping an expired task, the reaper's has_active_ssm_session treats an explicit enableExecuteCommand=False as safe-to-reap, queries SSM DescribeSessions (paginated via NextToken, target ecs:{cluster}_{task_id}_{runtime_id}) only when enableExecuteCommand is explicitly True, and raises SessionCheckError for every other case (missing/non-boolean flag, no container detail, a RUNNING-or-ambiguous container missing runtimeId, or no checkable RUNNING container); a detected Active session increments a 'protected' counter and skips the stop while SessionCheckError increments 'errors' and likewise skips the stop rather than reaping the task.",
      "evidence": [
        {
          "resource": "repo://lambda/reap-tasks/handler.py#L135-L166",
          "version": "repo-lines-v1:sha256:099aab3e975d232dc247eb2b24733b20ce55c33553841c6b7040a87cf1734661:"
        },
        {
