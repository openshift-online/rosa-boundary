#!/usr/bin/env python3
"""Start an optional restricted-scope Claude session; never downgrade on failure."""
import argparse
import os
from pathlib import Path
import stat
import subprocess
import sys

APPA = Path('/usr/local/bin/appa')
CLAUDE = Path('/usr/local/lib/claude-code/claude')
CONFIG = Path('/etc/rosa-boundary/openappa')
STATE = Path('/var/lib/rosa-boundary/openappa')
TOOLS = 'Bash,Read,Write,Edit,Glob,Grep,WebFetch,WebSearch,TodoWrite,AskUserQuestion'


def launch_environment():
    """Use image-managed policy/state, preserving existing Bedrock/AWS settings."""
    env = {key: value for key, value in os.environ.items() if not key.startswith('APPA_')}
    for key in ('BUN_OPTIONS', 'NODE_OPTIONS', 'CLAUDE_CODE_SIMPLE'):
        env.pop(key, None)
    env.update({
        'APPA_CONFIG_DIR': str(CONFIG),
        'APPA_DATA_DIR': str(STATE),
        'APPA_RUNTIME_URL': 'http://127.0.0.1:8787',
        'APPA_GATE': '1',
        'PATH': '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',
        'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC': '1',
        'CLAUDE_CODE_DISABLE_AGENT_VIEW': '1',
        'DISABLE_AUTOUPDATER': '1',
        'OTEL_SDK_DISABLED': 'true',
    })
    return env


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        'Fresh sessions only; no scope override, resume, custom settings or MCP servers. '
        'WebFetch/WebSearch are denied. Bash/network traffic and model requests are not sandboxed. '
        'Ordinary claude and the human shell are unchanged.'))
    parser.add_argument('-p', '--print', action='store_true', help='print one response and exit')
    parser.add_argument('prompt', nargs='?', help='optional investigation prompt')
    args = parser.parse_args(argv)
    if os.geteuid() == 0:
        parser.error('run as the non-root sre workload user')
    try:
        info = STATE.lstat()
        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid()
                or stat.S_IMODE(info.st_mode) != 0o700):
            raise ValueError('APPA state must be a private, task-local directory owned by this user')
        for name in ('appa.toml', 'claude-settings.json', 'mcp.json'):
            if not (CONFIG / name).is_file():
                raise ValueError('image-managed OpenAPPA configuration is missing')
        env = launch_environment()
        subprocess.run([str(APPA), 'describe', '--config', str(CONFIG / 'appa.toml'), '--check'],
                       env=env, stdout=subprocess.DEVNULL, check=True, timeout=30)
        # APPA 0.40.1's protected-launch adds a messaging flag unsupported by
        # Boundary's Claude 2.1.199. Fresh, non-delegating sessions instead use
        # the supported APPA_GATE + complete lifecycle hooks integration.
        # Every new/cleared root starts internal; no resume/fork flags are exposed.
        command = [str(CLAUDE), '--settings', str(CONFIG / 'claude-settings.json'), '--setting-sources=',
                   '--strict-mcp-config', f'--mcp-config={CONFIG / "mcp.json"}',
                   f'--tools={TOOLS}', '--disable-slash-commands']
        if args.print:
            command.append('--print')
        if args.prompt is not None:
            # Separate the prompt from options, including a prompt starting with '-'.
            command.extend(['--', args.prompt])
        print('Boundary Claude: restricted scope (public web tools denied; not a network sandbox).',
              file=sys.stderr)
        os.execve(str(CLAUDE), command, env)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'Cannot start guarded Claude: {error}. No unprotected fallback was started.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
