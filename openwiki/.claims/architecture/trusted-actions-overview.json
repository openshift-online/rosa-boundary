  "claims": [
    {
      "id": "claim_4275808ba78f45a3a7efb3aa5a6a2cfe",
      "statement": "Trusted Actions' intended callers are the rosa-boundary CLI running inside the SRE investigation container, plus external consumers CAD and the ROSA AI agent, all reaching Trusted Actions over HTTP; Trusted Actions validates callers against OCM/AMS and reaches managed clusters only through a short-lived, RBAC-scoped Backplane session. A second execution scope reaches AWS directly using per-cluster credentials resolved through OCM and Backplane's cloud-credentials flow (or a static/local-emulator provider for local development); both the Kubernetes-scoped (KubeApi) and AWS-scoped (AwsApi) execution paths are implemented in the catalog and executor today, not merely planned.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/cmd/server/main.go#L276-L343",
          "version": "repo-lines-v1:sha256:b7deb271cf57430cff0ccfa5043c1706731f2e7f1cda70fae0151868d8b5f49b:"
        },
        {
