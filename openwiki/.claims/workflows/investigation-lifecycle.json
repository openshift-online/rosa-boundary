    {
      "id": "claim_185991272b044614a1f5b9a803cd73d9",
      "statement": "`investigation close` previews the workspace then gates submission via `closeSubmissionGate`: `--dry-run` never submits, `--yes` skips interactive confirmation, and otherwise an interactive terminal must confirm; `--force` only sets the request's stop-consent scope and does not bypass the close service's refusal while a shell is attached. `--status` reads recorded progress without requesting work, and `--wait` only polls until an end state, the wait limit, or credential expiry, never cancelling the request when the wait ends.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/cli.go#L288-L318",
          "version": "repo-lines-v1:sha256:16818cf1ccb8fa08e5b9749c51bb8b51ab77337b1781e6b00fa12e89fd230d05:"
        },
        {
