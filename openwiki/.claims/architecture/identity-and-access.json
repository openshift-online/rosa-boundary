    {
      "id": "claim_b6bf8e2a9d734a579e07ff19fcba8aee",
      "statement": "A dedicated content-replication IAM role, separate from the account's pre-existing audit replication role, trusts the S3 service principal with no condition and is always created alongside the GitHub content-publisher roles, independent of whether audit replication is enabled.",
      "evidence": [
