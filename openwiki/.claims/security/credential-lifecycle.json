    },
    {
      "id": "claim_205ab5edd0f746488eb9cd1692b4f6f1",
      "statement": "ABAC isolation for the shared SRE role depends on AWS STS auto-converting the Keycloak JWT's https://aws.amazon.com/tags claim into session tags during AssumeRoleWithWebIdentity (which requires sts:TagSession in the trust policy), which regional permission policies then match via ${aws:PrincipalTag/<tag>} conditions against resource tags such as ecs:ResourceTag/<tag>, enforcing per-SRE task isolation at the AWS API layer without creating a separate IAM role per user.",
      "evidence": [
        {
          "resource": "repo://deploy/account/modules/shared-iam/oidc.tf#L9-L18",
          "version": "repo-lines-v1:sha256:abd9a4057652678bcf492d30dbcc2918276e5c648b7703f2defdae168f0c57c5:"
        }
      ]
    },
    {
      "id": "claim_f2eeb80003714b0791ebc0b090471f00",
      "statement": "Role session durations differ by identity type: sre_shared uses the configurable oidc_session_duration (default 3600s, validated to 3600-43200s), content_publisher roles use content_publisher_session_duration (default 3600s, same validated range), and lambda_invoker is hardcoded to the AWS minimum of 3600 seconds regardless of any configuration input, reflecting that its sessions are expected to be very short-lived.",
      "evidence": [
