    {
      "id": "claim_7d5dff51c17f4217a1329802709c5d62",
      "statement": "The device-authorization flow (acquireDeviceToken in internal/auth/device.go) is a distinct implementation from the PKCE browser flow: it is selected by explicit --use-device-code=true, else ROSA_BOUNDARY_OIDC_USE_DEVICE_CODE, else the profile's saved oidc_use_device_code, else default false; it validates the provider's device-authorization response (expiry bounds, verification URI scheme/host, user-code length, absence of control characters, and that the URI does not embed the device code) before displaying it, and bounds polling to the provider's expires_in window while handling authorization_pending, slow_down, access_denied, and expired_token.",
      "evidence": [
        {
          "resource": "repo://internal/auth/device.go#L40-L151",
          "version": "repo-lines-v1:sha256:5db611cd67225f26288c982c5a26502833b6fd80d48028185fbe734fd0a6c7e3:"
        },
        {
