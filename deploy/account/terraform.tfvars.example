# Documentation placeholders only: replace with explicit target/migration inputs.
aws_account_id                    = "123456789012"
aws_region                        = "us-east-1"
project                           = "rosa-boundary"
stage                             = "dev"
adopt_existing_resources          = false
bedrock_budget_tag_region         = "us-east-1"
bedrock_monthly_budget_usd         = 1000
bedrock_budget_notification_email = "alerts@example.com"
# Development Keycloak provider; confirm access and verify the current top CA
# SHA-1 TLS thumbprint before applying. Replace both for a different provider.
keycloak_issuer_url               = "https://keycloak-keycloak.apps.rosa.tsw-boundary.e5fo.p3.openshiftapps.com/realms/rosa-boundary"
keycloak_thumbprint               = "859d0de987308d5b84f09190044ee3e3108fad79"
oidc_client_id                    = "rosa-boundary-sre"

# Copy the original activation manifest and retain its management endpoint above.
bedrock_model_agreements = {}

# One identity set, shared by EVERY regional stack. No resource ARNs required.
role_name_prefix       = "rosa-boundary-dev"
legacy_role_tag_region = "us-east-1"
# Copy account output regional_iam_contract to every regional workspace. Exactly
# one region keeps old policy names; other regions append -<aws_region>.
legacy_policy_region = "us-east-1"

# Default [] preserves legacy single-region Bedrock trust. Before enabling logging
# in more regions, explicitly approve all source regions including the legacy one.
bedrock_logging_source_regions = []
# Enable once if any regional workspace configures S3 audit replication.
enable_s3_replication_role = false

# Optional read-only identity for an external metrics collector. Identity and
# trust only: its permissions are the regional enable_metrics_read_grant inline
# policy, which must be enabled in a LATER apply because the regional root looks
# this role up by name. Callers must be complete role ARNs; account roots,
# service principals and wildcards are rejected.
enable_metrics_read_role            = false
metrics_read_trusted_principal_arns = []
# metrics_read_trusted_principal_arns = ["arn:aws:iam::210987654321:role/example-collector"]
metrics_read_session_duration = 3600

# Content publishing and replication identities. Identity and trust only: the
# prefix-scoped bucket and key permissions are a separate, later regional
# change. Publishers and the dedicated content replication role are always
# created. The latter is NOT the audit replication role above. Check the account's
# existing OIDC providers and review its plan before applying. Git-managed
# Boundary workspaces require manual approval of applies.
# Set false to reference a GitHub Actions provider another state owns instead
# of creating one here. Combine with adopt_existing_resources to import one.
create_github_actions_oidc_provider = true
# Defaults already name the three agreed sources; override only to add or
# retire one. Branches are plain names, never refs. Audience is always
# sts.amazonaws.com and is not configurable.
# content_publisher_sources = {
#   ops-sop               = { repository = "openshift/ops-sop", branch = "master" }
#   managed-notifications = { repository = "openshift/managed-notifications", branch = "master" }
#   rosa-claude-plugins   = { repository = "openshift-online/rosa-claude-plugins", branch = "main" }
# }
content_publisher_session_duration = 3600

# Match original trust inputs, especially nondefaults. abac_tag_key remains a
# regional permission-policy input; all regional stacks must match the JWT tags.
oidc_session_duration         = 3600
enable_uuid_allowlist         = false
allowed_uuids                 = []
enable_oidc_group_enforcement = true
required_oidc_role            = "ai-sd-sre"
