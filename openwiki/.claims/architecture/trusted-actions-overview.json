    {
      "id": "claim_df5cf81df374456f94d776a926467fdf",
      "statement": "The executor dispatches each action to whichever of its two Scope implementations (KubeScope or AWSScope) reports Supports(action) true; AWSScope resolves the target cluster's AWS region, and for AWS write actions also its infrastructure ID, via the AWS client provider (which in turn resolves through OCM), and a write action fixes its own Operation() and Resource() so a target param cannot relabel what is being changed, with the instance's cluster-ownership tag checked before the write proceeds.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/internal/executor/aws.go#L33-L89",
          "version": "repo-lines-v1:sha256:4fb645f9b60f8c19d1e488925b1ea793455858e1e747c77ac0b990613e127bd6:"
        },
