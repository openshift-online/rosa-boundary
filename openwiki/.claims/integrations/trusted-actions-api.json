    {
      "id": "claim_5ff373a7ca774e9993fefb88528048f1",
      "statement": "cmd/rta is a thin main wrapping internal/rta.NewCommand(); the internal/rta.Client it uses refuses to send a bearer token over plain HTTP except to localhost/loopback addresses, rejects HTTPS-to-HTTP downgrade redirects, and resolves tokens via --token flag first then an OCM CLI config file's access token, failing explicitly rather than sending an expired or empty token.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/cmd/rta/main.go#L1-L17",
