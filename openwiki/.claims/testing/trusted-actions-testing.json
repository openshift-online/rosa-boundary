    {
      "id": "claim_7aded801f04d4338a2dd5e812a077099",
      "statement": "Trusted Actions is an independent Go module (module github.com/openshift-online/rosa-trusted-actions) under components/trusted-actions/ with its own go.mod and Makefile; root-level `go test ./...` and root Makefile targets do not exercise it, so Trusted Actions commands must be run from components/trusted-actions/ (e.g. `make -C components/trusted-actions test`), as stated directly in docs/trusted-actions-monorepo-migration.md: \"Run Trusted Actions builds and tests from components/trusted-actions/; Boundary's root Go and Make commands do not cover its separate module.\"",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/Makefile#L1-L20",
          "version": "repo-lines-v1:sha256:1b9093d34b01c9d1f993ae36fa2464b3d5d17084770084d133950016c9c70c96:"
