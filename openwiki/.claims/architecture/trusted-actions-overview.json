    {
      "id": "claim_f20871e00d0344e092191ae148d0dbd6",
      "statement": "The request-handling middleware stack applies, in order, custom logging, request-ID generation, panic recovery, real-IP resolution, a 60-second timeout, permissive CORS, and then (only on action routes) authentication, auditing, and authorization.",
