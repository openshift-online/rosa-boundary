        }
      ]
    },
    {
      "id": "claim_5e9bdf157a854ad4a17382e5619b20ed",
      "statement": "executor.Executor.Execute builds an audit.Record at the start of each call and logs it via a deferred e.auditor.Log(rec) call, so every exit path — missing scope, target-derivation failure, authorization denial, scope execution failure, or success — results in exactly one audit record being logged regardless of execution outcome.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/internal/executor/executor.go#L93-L159",
          "version": "repo-lines-v1:sha256:f384618a4ea92aea25534aaf7ce36ff6fa75ff714c39c678938eb868eb45d2f8:"
        }
