    {
      "id": "claim_f69cb4b9d677482daca73980ffaf3abd",
      "statement": "assumeRoleWithRetryOptions retries a failed AssumeRoleWithWebIdentity call exactly once, and only when the token used came from the cache and the STS error matches isAuthError (ExpiredToken, InvalidClientTokenId, or an InvalidIdentityToken whose message does not also mention a claim, principal, or tag failure); SignatureDoesNotMatch is deliberately excluded since it indicates clock skew or request-signing issues a retry cannot fix, and the retry clears the cache via auth.ClearToken and forces a fresh login through the same OIDC flow rather than switching between browser and device mode.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/root.go#L108-L163",
          "version": "repo-lines-v1:sha256:3e7be0af6ea87007716e05be4b3b8b130d001b15a7ae5e4e907757e61877bb71:"
        }
      ]
    }
