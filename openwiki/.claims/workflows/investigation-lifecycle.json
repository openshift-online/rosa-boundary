          "version": "repo-lines-v1:sha256:ecdc8518ff4eb4016ed9cf866f7959aa2d333c75101385cb309476a9556640da:"
        }
      ]
    },
    {
      "id": "claim_fdfc1d2244134e45a6a2875bf32fd797",
      "statement": "Scheduled discovery checks workspace identifiers and paths and distinguishes idle eligibility from expiry. Expiry closes admission, not a live shell.",
