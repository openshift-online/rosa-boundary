{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "enabledManagers": [
    "gomod",
    "pep621",
    "terraform",
    "pre-commit",
    "github-actions",
    "tekton",
    "custom.regex"
  ],
  "tekton": {
    "managerFilePatterns": ["/^\\.tekton\\/rosa-trusted-actions-.*\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the pinned backplane-tools GitHub release",
      "managerFilePatterns": ["/^Containerfile$/"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=openshift/backplane-tools\\s+ARG BACKPLANE_TOOLS_VERSION=\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "openshift/backplane-tools",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Review Python dependency updates; do not automerge",
      "matchManagers": ["pep621"],
      "automerge": false
    },
    {
      "description": "Group non-major Python dependency updates for the uv-locked Lambda",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "python dependencies"
    },
    {
      "description": "Group all Go module patch/minor updates, including AWS SDK modules, into a single PR",
      "matchManagers": ["gomod"],
      "matchFileNames": ["go.mod"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "gomod dependencies"
    },
    {
      "description": "Review all Trusted Actions dependency updates, including Terraform, instead of inheriting Boundary automerge",
      "matchFileNames": ["components/trusted-actions/**"],
      "automerge": false
    },
    {
      "description": "Keep non-major Trusted Actions Go updates separate from Boundary",
      "matchManagers": ["gomod"],
      "matchFileNames": ["components/trusted-actions/go.mod"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "trusted-actions gomod dependencies"
    },
    {
      "description": "Do not update Trusted Actions' pinned go-yit dependency",
      "matchManagers": ["gomod"],
      "matchFileNames": ["components/trusted-actions/go.mod"],
      "matchPackageNames": ["github.com/dprotaso/go-yit"],
      "enabled": false
    },
    {
      "description": "Review Trusted Actions Tekton updates rather than automerging them",
      "matchManagers": ["tekton"],
      "matchFileNames": [".tekton/rosa-trusted-actions-*.yaml"],
      "automerge": false
    },
    {
      "description": "Group all GitHub Actions updates into a single PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
