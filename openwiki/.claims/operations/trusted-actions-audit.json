    {
      "id": "claim_00822a374808446cbb9b1c58cf32b897",
      "statement": "cmd/server/main.go selects the SQLiteStore backend for the application database (audit_entries and executions tables) because store.New treats any DATABASE_URL that is not a postgres:// or postgresql:// DSN as SQLite, and terraform/regional/ecs.tf sets DATABASE_URL to the literal path /data/trusted_actions.db, so the regional production deployment runs on SQLiteStore even though that store's own doc comment recommends PostgresStore for production.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/internal/store/sqlite.go#L24-L37",
