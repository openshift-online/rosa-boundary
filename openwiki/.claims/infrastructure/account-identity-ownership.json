    {
      "id": "claim_cc433ea677d1410eb4cf7f3c3f8e788a",
      "statement": "The deploy/account Terraform root owns ROSA Boundary's IAM role identities and trust policies, OIDC providers, common AWS-managed policy attachments, and the account-wide Bedrock budget and model agreements, while deploy/regional owns the inline permission grants on those roles plus ECS/EFS/S3/KMS/Lambda/logging resources and resource policies.",
      "evidence": [
        {
          "resource": "repo://deploy/account/README.md#L1-L22",
          "version": "repo-lines-v1:sha256:2ac9496218b6e915d165b72556ef8a9306d13a47bed9a63576a5095c560ffb43:"
        }
      ]
    },
    {
