    {
      "id": "claim_0bf43d255dfd465d87e5f76577be76b2",
      "statement": "deploy/account/main.tf instantiates the shared_iam module exactly once as the sole creator of every account-global identity (SRE/invoker/Lambda roles, metrics-read, S3 replication, and the GitHub Actions publisher/replication roles), resolving the Keycloak and GitHub Actions OIDC provider ARNs in the account root beforehand and passing them into the module as inputs; regional Terraform roots only attach grants to these identities and never define their own.",
      "evidence": [
        {
          "resource": "repo://deploy/account/main.tf#L42-L77",
          "version": "repo-lines-v1:sha256:6a9db877db55bb20eb240b652b869b881f7ef1bfbfde455000e568bf01c8fde7:"
