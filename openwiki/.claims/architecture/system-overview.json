    {
      "id": "claim_76884b821b53487b86fc78ce03a31c7d",
      "statement": "Before launching a replacement task, create-investigation checks SSM sessions for existing-task containers with a runtimeId. Active sessions, empty task details, and ECS/SSM API errors block handover, but missing runtimeId skips the SSM lookup. Only after preflight does it stop existing tasks and wait for STOPPED; stop or wait failure prevents replacement launch.",
      "evidence": [
        {
          "resource": "repo://lambda/create-investigation/handler.py#L734-L826",
          "version": "repo-lines-v1:sha256:53180f96b3890eb224de3adbbd4a106a989161b1380a4abfc32676bb40656304:"
        }
      ]
    },
    {
      "id": "claim_1829b739e62f4ce4bdf5959a770ebf74",
      "statement": "The reap-investigations Lambda (lambda/reap-investigations/handler.py) is a third, independently scheduled component distinct from reap-tasks: it runs on a multi-hour EventBridge schedule (var.investigation_reaper_schedule_hours) and garbage-collects whole stale investigations rather than enforcing individual task deadlines, which reap-tasks continues to do on its short-interval schedule.",
      "evidence": [
        {
          "resource": "repo://deploy/regional/lambda-reap-investigations.tf#L173-L223",
          "version": "repo-lines-v1:sha256:70ec5f84d985fb926efce929e750c6813011ed338167a9a996935509c690f248:"
