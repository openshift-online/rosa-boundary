    {
      "id": "claim_14d12e3b282c4903a7521cc73447cd4e",
      "statement": "The create-investigation Lambda registers a per-investigation ECS task definition that replaces the EFS home volume with the investigation's access point, strips and re-adds task-scoped (non-EFS) overlay volumes for the OCM config and kubeconfig credential paths using path-traversal-safe protected_mount_path checks, and injects a Secrets Manager kubeconfig reference into the kube-proxy sidecar's secrets.",
      "evidence": [
        {
          "resource": "repo://lambda/create-investigation/handler.py#L521-L690",
          "version": "repo-lines-v1:sha256:4fdfb1fc2a8b40fcf321cbfa8332c2ea80b9f83eff3ef746d80a63aa944dd2f0:"
