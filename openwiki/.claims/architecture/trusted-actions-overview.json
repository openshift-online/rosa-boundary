    {
      "id": "claim_4275808ba78f45a3a7efb3aa5a6a2cfe",
      "statement": "Trusted Actions' intended callers are the rosa-boundary CLI running inside the SRE investigation container, plus external consumers CAD and the ROSA AI agent, all reaching Trusted Actions over HTTP; Trusted Actions validates callers against OCM/AMS and reaches managed clusters only through a short-lived, RBAC-scoped Backplane session, and direct AWS-API scope execution is not yet implemented end-to-end.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/ARCHITECTURE.md#L7-L29",
          "version": "repo-lines-v1:sha256:82469e8db8016a1dee607837e1daccbc16067d6b80dbc8e65ab6ce84bf6707d1:"
        }
      ]
    },
    {
      "id": "claim_4393b0fcfe4f4e0ea7dd76dec15b39dd",
      "statement": "Nothing in the Boundary root Containerfile or in internal/cmd (the rosa-boundary CLI's command package) currently invokes the Trusted Actions HTTP API or an rta client; the architectural edge from the investigation container to Trusted Actions is not yet wired in code.",
