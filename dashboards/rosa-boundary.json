      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "interval": "2m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "aws_lambda_invocations_sum{job=~\"cloudwatch-exporter-rosa-boundary-.*\",account=~\"rosa-boundary-(stage|prod)\",region=~\"${region:regex}\",function_name=~\"${function:regex}\"} offset 10m",
          "legendFormat": "{{region}} · {{function_name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 0,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lambda invocation errors · sampled 1m buckets",
      "description": "Latest observed 60-second CloudWatch bucket at each query step, shifted forward by 10 minutes using offset 10m for the exporter delay. Buckets can repeat; 120-second scraping can omit intervening buckets. These are sampled period values, not a time-range total or a counter. Missing data is not converted to zero. Handled HTTP errors and per-resource reaper failures may return normally and do not necessarily increment native Lambda Errors.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "interval": "2m",
      "targets": [
        {
          "datasource": {
