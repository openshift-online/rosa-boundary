#!/bin/bash

# Task-side receiver for short-lived credentials sent through ECS Exec stdin.
# Writable paths are fixed to task-scoped mounts so credential material never
# enters the investigation's EFS-backed home directory.

OCM_CONFIG_DIR=/home/sre/.config/ocm
KUBECONFIG_DIR=/home/sre/.kube
MAX_REQUEST_BYTES=65536
READY_MARKER=__ROSA_BOUNDARY_CREDENTIAL_OCM_READY__
SUCCESS_MARKER=__ROSA_BOUNDARY_CREDENTIAL_OCM_SUCCESS__
OCM_CLIENT_ID=ocm-cli
OCM_TOKEN_URL=https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token

# Print a fixed error message that cannot contain request or command output.
fail() {
    printf 'Credential operation failed: %s\n' "$1" >&2
    return 1
}

# Return success only for OCM API URLs approved for credential transfer.
is_approved_ocm_url() {
    case "$1" in
        https://api.openshift.com | https://api.stage.openshift.com | https://api.integration.openshift.com)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Remove configure temporary files and restore terminal echo on every exit.
cleanup_configure() {
    local exit_code=$?

    if [[ -n "${request_file:-}" ]]; then
        rm --force -- "${request_file}"
    fi
    if [[ -n "${candidate_file:-}" ]]; then
        rm --force -- "${candidate_file}"
    fi
    if [[ "${echo_disabled:-0}" == 1 ]]; then
        stty echo 2>/dev/null || true
    fi
    return "${exit_code}"
}

# Configure an access-token-only OCM client after validating it with ocm whoami.
configure_ocm() (
    local payload
    local request_url
    local request_file=''
    local candidate_file=''
    local echo_disabled=0

    umask 077
    trap cleanup_configure EXIT
    trap 'exit 130' HUP INT TERM

    if ! stty -echo 2>/dev/null; then
        fail 'unable to secure terminal input'
        return 1
    fi
    echo_disabled=1
    printf '%s\n' "${READY_MARKER}"

    # read stops at the first newline or one byte beyond the accepted bound.
    # ECS Exec stdin intentionally remains open while validation runs.
    payload=''
    IFS= read -r -n "$((MAX_REQUEST_BYTES + 1))" payload || true
    if [[ -z "${payload}" || ${#payload} -gt ${MAX_REQUEST_BYTES} ]]; then
        fail 'invalid request size'
        return 1
    fi

    request_file=$(mktemp "${OCM_CONFIG_DIR}/.rosa-boundary-credential-request.XXXXXX") || {
        fail 'unable to create request file'
        return 1
    }
    candidate_file=$(mktemp "${OCM_CONFIG_DIR}/.rosa-boundary-credential-candidate.XXXXXX") || {
        fail 'unable to create candidate file'
        return 1
    }
    chmod 0600 "${request_file}" "${candidate_file}"

    if ! printf '%s' "${payload}" | base64 --decode >"${request_file}" 2>/dev/null; then
        fail 'request is not valid base64'
        return 1
    fi
    unset payload

    # Exact keys prevent refresh, offline, and future unknown credential fields
    # from being copied into the task configuration.
    if ! jq --exit-status '
        type == "object" and
        (keys | sort) == ["access_token", "url"] and
        (.access_token | type == "string" and length > 0) and
        (.url | type == "string")
    ' "${request_file}" >/dev/null 2>&1; then
        fail 'request has invalid fields'
        return 1
    fi

    request_url=$(jq --raw-output '.url' "${request_file}")
    if ! is_approved_ocm_url "${request_url}"; then
        fail 'OCM URL is not approved'
        return 1
    fi

    if ! jq --compact-output \
        --arg client_id "${OCM_CLIENT_ID}" \
        --arg token_url "${OCM_TOKEN_URL}" \
        '{access_token, client_id: $client_id, scopes: ["openid"], token_url: $token_url, url}' \
        "${request_file}" >"${candidate_file}" 2>/dev/null; then
        fail 'unable to construct OCM configuration'
        return 1
    fi
    chmod 0600 "${candidate_file}"

    # Discard both streams because whoami output can contain personal data.
    # Remove task environment overrides so validation uses the candidate URL.
    if ! env \
        --unset=OCM_CONFIG \
        --unset=OCM_KEYRING \
        --unset=OCM_URL \
        HOME=/home/sre \
        XDG_CONFIG_HOME=/home/sre/.config \
        OCM_CONFIG="${candidate_file}" \
        ocm whoami >/dev/null 2>&1; then
        fail 'OCM credential validation failed'
        return 1
    fi

    mv --force -- "${candidate_file}" "${OCM_CONFIG_DIR}/ocm.json"
    candidate_file=''
    printf '%s\n' "${SUCCESS_MARKER}"
)

# Clear all helper OCM state and any kubeconfig that may contain an OCM token.
clear_ocm() {
    rm --force -- \
        "${OCM_CONFIG_DIR}/ocm.json" \
        "${OCM_CONFIG_DIR}"/.rosa-boundary-credential-request.* \
        "${OCM_CONFIG_DIR}"/.rosa-boundary-credential-candidate.* \
        "${KUBECONFIG_DIR}/config"
    printf '%s\n' "${SUCCESS_MARKER}"
}

# Dispatch only the fixed provider operations supported by this helper.
main() {
    if [[ $# -ne 2 || "$2" != ocm ]]; then
        fail 'usage: rosa-boundary-credential-helper configure|clear ocm'
        return 2
    fi

    case "$1" in
        configure)
            configure_ocm
            ;;
        clear)
            clear_ocm
            ;;
        *)
            fail 'usage: rosa-boundary-credential-helper configure|clear ocm'
            return 2
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
