          },
          "editorMode": "code",
          "expr": "aws_lambda_duration_average{job=~\"cloudwatch-exporter-rosa-boundary-.*\",account=~\"rosa-boundary-(stage|prod)\",region=~\"${region:regex}\",function_name=~\"${function:regex}\"} offset 10m",
          "legendFormat": "{{region}} · {{function_name}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "No samples",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 0,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
