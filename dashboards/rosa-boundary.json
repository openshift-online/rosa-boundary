          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Lambda duration · bucket maximum",
      "description": "Latest observed 60-second CloudWatch bucket at each query step, shifted forward by 10 minutes using offset 10m for the exporter delay. Buckets can repeat; 120-second scraping can omit intervening buckets. These are sampled period values, not a time-range total or a counter. Missing data is not converted to zero. CloudWatch Maximum for each observed bucket, in milliseconds; not a percentile.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "interval": "2m",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "aws_lambda_duration_maximum{job=~\"cloudwatch-exporter-rosa-boundary-.*\",account=~\"rosa-boundary-(stage|prod)\",region=~\"${region:regex}\",function_name=~\"${function:regex}\"} offset 10m",
          "legendFormat": "{{region}} · {{function_name}}",
          "range": true,
