    {
      "id": "claim_c8f310c311ac48c29b5b71786204d057",
      "statement": "Reaping a stale investigation deletes the EFS directory contents only after a mandatory S3 backup succeeds (refusing deletion if backup fails or S3_AUDIT_BUCKET is unset), then re-verifies immediately before deleting the access point that it is still the sole unsealed access point at that path and that Lambda execution time remains, aborting the whole reap with no access-point or task-definition cleanup if either check fails, then deletes the EFS access point, and only afterward attempts to deregister any ECS task definitions whose family matches the investigation's {TASK_DEFINITION_FAMILY}-{cluster_id}-{investigation_id}-<timestamp> pattern — task-definition deregistration is attempted even if the access-point deletion step itself failed, but never if the earlier directory-deletion or seal/budget recheck aborted first.",
      "evidence": [
        {
          "resource": "repo://lambda/reap-investigations/handler.py#L464-L519",
