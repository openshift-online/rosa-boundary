    {
      "id": "claim_5db88d919e154e5d8b7b0c8620b77ef2",
      "statement": "store.NewWithIAM picks one of three Store backends in priority order: IAM-Postgres (newIAMPostgresStore) if any IAM-token field is set, requiring the full host/port/name/user/region contract and failing loudly on a partial one; otherwise password-DSN Postgres (NewPostgresStore) if DatabaseURL has a postgres:// or postgresql:// prefix; otherwise SQLite (NewSQLiteStore) as the fallback, including when DatabaseURL is empty.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/internal/store/postgres_iam.go#L96-L111",
