# =============================================================================
# create-investigation Lambda Container Image
# =============================================================================
#
# Packages the create-investigation Lambda handler as a container image for
# deployment via ECR. This replaces the ZIP packaging approach that was
# incompatible with HCP Terraform remote execution (no Podman/pip on runners).
#
# Base image: AWS Lambda Python 3.11 runtime (public ECR, Amazon Linux 2).
# Not pinned by digest: AWS manages security patches for Lambda base images
# and the runtime expects compatible base image versions. This is an
# intentional divergence from the main container's pinned-digest pattern.
#
# Architecture: linux/amd64 only (Lambda x86_64). Multi-arch via
# platform_convert does not apply — Lambda functions target a single arch.
#
# HEALTHCHECK: not applicable. AWS Lambda ignores Docker health checks and
# manages function health through its own invocation lifecycle.
#
# Build:
#   podman build --tag create-investigation-lambda:dev \
#     --file lambda/create-investigation/Containerfile lambda/create-investigation/
#
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: dependency builder
# ---------------------------------------------------------------------------
# Uses the same Lambda base image as the final stage to guarantee glibc ABI
# compatibility for compiled wheels (cryptography, cffi). A separate builder
# image (e.g. python:3.11-slim) has a newer glibc, producing .so files that
# fail to load in the Lambda runtime (Amazon Linux 2, glibc 2.26).
#
# uv is copied in to export a pip-compatible requirements file from the
# lockfile, then pip installs compiled wheels into a clean target directory.
# ---------------------------------------------------------------------------
FROM public.ecr.aws/lambda/python:3.11 AS builder

# Install uv for lockfile export (produces requirements-lock.txt from uv.lock).
# Pinned by version and manifest digest for reproducible builds.
ARG UV_VERSION=0.7.12
COPY --from=ghcr.io/astral-sh/uv:${UV_VERSION}@sha256:4faec156e35a5f345d57804d8858c6ba1cf6352ce5f4bffc11b7fdebdef46a38 /uv /usr/local/bin/uv

WORKDIR /build

# Copy only dependency-specification files first for layer caching.
# Changes to handler.py alone will not bust this layer.
COPY pyproject.toml uv.lock ./

# Export pinned runtime dependencies (no dev deps, no project itself) from the
# lockfile into a pip-compatible requirements file, then install them into a
# clean target directory that will be copied to the final image.
RUN uv export --frozen --no-dev --no-emit-project --output-file requirements-lock.txt && \
    pip install \
        --no-cache-dir \
        --target /deps \
        --requirement requirements-lock.txt

# ---------------------------------------------------------------------------
# Stage 2: final Lambda runtime image
# ---------------------------------------------------------------------------
# Uses the official AWS Lambda Python 3.11 base image which provides the
# Lambda Runtime Interface Client (RIC) and the runtime bootstrap. We copy
# in the pre-built dependencies and the handler source.
# ---------------------------------------------------------------------------
FROM public.ecr.aws/lambda/python:3.11

LABEL org.opencontainers.image.title="create-investigation-lambda" \
      org.opencontainers.image.description="OIDC-authenticated Lambda for creating rosa-boundary investigation tasks" \
      org.opencontainers.image.source="https://github.com/openshift-online/rosa-boundary" \
      org.opencontainers.image.vendor="Red Hat"

# Copy pre-built Python dependencies from the builder stage into the Lambda
# task root. The trailing slash on the destination ensures files land directly
# in LAMBDA_TASK_ROOT rather than in a subdirectory.
COPY --chmod=0644 --from=builder /deps/ ${LAMBDA_TASK_ROOT}/

# Copy the Lambda handler source. This layer is small and changes frequently,
# so it sits after the dependency layer for optimal cache behaviour.
COPY --chmod=0644 handler.py ${LAMBDA_TASK_ROOT}/

# Set the Lambda handler entrypoint: module.function
CMD ["handler.lambda_handler"]
