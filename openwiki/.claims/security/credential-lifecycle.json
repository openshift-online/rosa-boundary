          "version": "repo-lines-v1:sha256:03748e0e996ca7df0a687fdd7fefa2bfb18822a8bd7581c690d0cb9e352f3773:"
        }
      ]
    },
    {
      "id": "claim_14c612bcc3f044c99a506586606402a1",
      "statement": "The GitHub Actions OIDC provider supports create/reference/adopt modes gated by create_github_actions_oidc_provider and adopt_existing_resources (AWS allows only one provider per issuer URL per account so the wrong mode fails the plan rather than duplicating or destroying), pins no thumbprint, and resolves to local.github_actions_provider_arn regardless of which mode produced it; the trust audience sts.amazonaws.com is a hardcoded local with no corresponding account-root variable, which prevents any workspace from widening the publisher trust audience.",
      "evidence": [
        {
          "resource": "repo://deploy/account/github-oidc.tf#L1-L63",
          "version": "repo-lines-v1:sha256:0d1403e788eacf041036d9e8035773c6824818818c2b6bad13b76f2885255644:"
        },
        {
          "resource": "repo://deploy/account/outputs.tf#L39-L41",
          "version": "repo-lines-v1:sha256:ce61d68974423af1dfbe51f0b5a4b1c4c5a51367e3b118f6090b63a14cabfc31:"
        }
      ]
    },
    {
      "id": "claim_76bcb8f1c8b34053b58e16b8dbdc7ad5",
      "statement": "modules/shared-iam/content-publishing.tf creates one dedicated IAM publisher role per entry in content_publisher_sources (never a shared role across sources), each trusting only the GitHub Actions OIDC provider under a StringEquals condition on the fixed audience and a subject built as repo:<repository>:ref:refs/heads/<branch>; validation on that variable rejects wildcards, embedded ':' segments, full refs, duplicate repository/branch pairs across keys, and role names exceeding IAM's 64-character limit, and a role precondition fails the plan if github_actions_provider_arn is ever empty.",
      "evidence": [
        {
          "resource": "repo://deploy/account/modules/shared-iam/content-publishing.tf#L25-L70",
          "version": "repo-lines-v1:sha256:867c68f8b472a27413ac92c43956ca90dbcaa9461f72bb08f0f25967e2d6190f:"
        },
        {
          "resource": "repo://deploy/account/modules/shared-iam/variables.tf#L72-L113",
          "version": "repo-lines-v1:sha256:3a08dd6d5a6558c5f8cf90b58bc34584fafce6db8c9a3fc3a88b974535ea939d:"
        },
