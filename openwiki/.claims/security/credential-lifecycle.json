    {
      "id": "claim_7259b7df17d5436fbd4bb156b46a590d",
      "statement": "Both `session credentials configure ocm <session-id>` and `session create <cluster-id> --with-credentials ocm` invoke the same shared configureOCMForSession function, ensuring the CLI entrypoints share one acquire-transfer-install sequence; session create only triggers it after the task reaches RUNNING and ECS Exec is confirmed ready, to preserve the freshly issued token's useful lifetime. The standalone `session start`/`session stop` subcommands have been removed in favor of `session create`/`session close`.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/cli.go#L294-L304",
