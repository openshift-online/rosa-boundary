    {
      "id": "claim_8cd8e59c1a4349bd9c5e612dc1c9d49a",
      "statement": "Existing deployments migrate shared-identity ownership from deploy/regional to deploy/account using removed blocks with lifecycle.destroy=false in deploy/regional/account-handoff.tf to release IAM roles, managed-policy attachments, OIDC providers, the Bedrock budget, and model agreements from regional state without destroying the underlying AWS objects, followed by declarative import blocks in deploy/account/imports.tf (and a separate import in bedrock-model-agreements.tf) that adopt the same objects by role name, role/policy-arn, OIDC provider ARN, and account:name respectively, gated by var.adopt_existing_resources; regional inline policies are never released or imported and must remain at their original regional addresses.",
      "evidence": [
        {
          "resource": "repo://deploy/account/README.md#L94-L130",
          "version": "repo-lines-v1:sha256:c92b943b45f0a976c7c8d4ca9c9182389d5e15a82bd6fd0f67fecab8a5a99b8c:"
