#!/bin/bash

# Task-side receiver for short-lived credentials sent through ECS Exec stdin.
# Writable paths are fixed to task-scoped mounts so credential material never
# enters the investigation's EFS-backed home directory.

OCM_CONFIG_DIR=/home/sre/.config/ocm
KUBECONFIG_DIR=/home/sre/.kube
MAX_REQUEST_BYTES=65536
GENERATIONS_MARKER=__ROSA_BOUNDARY_CREDENTIAL_OCM_GENERATIONS_V1__
BACKPLANE_LOGIN_TIMEOUT=40
CLEAR_EPOCH_FILE=.rosa-boundary-credential-clear-epoch
READY_MARKER=__ROSA_BOUNDARY_CREDENTIAL_OCM_READY__
SUCCESS_MARKER=__ROSA_BOUNDARY_CREDENTIAL_OCM_SUCCESS__
BACKPLANE_MESSAGE_MARKER=__ROSA_BOUNDARY_BACKPLANE_MESSAGE__
OCM_CLIENT_ID=ocm-cli
OCM_TOKEN_URL=https://sso.redhat.com/auth/realms/redhat-external/protocol/openid-connect/token

# Print a fixed error message that cannot contain request or command output.
fail() {
    printf 'Credential operation failed: %s\n' "$1" >&2
    return 1
}

# Return success only for OCM API URLs approved for credential transfer.
is_approved_ocm_url() {
    case "$1" in
    https://api.openshift.com | https://api.stage.openshift.com | https://api.integration.openshift.com)
        return 0
        ;;
    *)
        return 1
        ;;
    esac
}

# Remove configure temporary files and restore terminal echo on every exit.
cleanup_configure() {
    local exit_code=$?

    if [[ -n "${request_file:-}" ]]; then
        rm --force -- "${request_file}"
    fi
    if [[ -n "${candidate_file:-}" ]]; then
        rm --force -- "${candidate_file}"
    fi
    if [[ "${echo_disabled:-0}" == 1 ]]; then
        stty echo 2>/dev/null || true
    fi
    return "${exit_code}"
}

# Keep a stable lock inode until task teardown.
lock_ocm() {
    exec 9>>"${OCM_CONFIG_DIR}/.rosa-boundary-credential-lock" && flock -x -w 5 9
}

configure_ocm() (
    local operation="$1"
    local payload generation expected current
    local generation_file="${OCM_CONFIG_DIR}/.rosa-boundary-credential-generation"
    local request_url
    local request_file=''
    local candidate_file=''
    local echo_disabled=0

    umask 077
    trap cleanup_configure EXIT
    trap 'exit 130' HUP INT TERM

    if ! stty -echo 2>/dev/null; then
        fail 'unable to secure terminal input'
        return 1
    fi
    echo_disabled=1
    # Legacy clients ignore this marker. Emit it before READY so new clients
    # can select the request format without waiting or retrying an upload.
    printf '%s\n' "${GENERATIONS_MARKER}" "${READY_MARKER}"

    # read stops at the first newline or one byte beyond the accepted bound.
    # ECS Exec stdin intentionally remains open while validation runs.
    payload=''
    if ! IFS= read -r -t 30 -n "$((MAX_REQUEST_BYTES + 1))" payload ||
        [[ -z "${payload}" || ${#payload} -gt ${MAX_REQUEST_BYTES} ]]; then
        fail 'invalid request size'
        return 1
    fi

    request_file=$(mktemp "${OCM_CONFIG_DIR}/.rosa-boundary-credential-request.XXXXXX") || {
        fail 'unable to create request file'
        return 1
    }
    candidate_file=$(mktemp "${OCM_CONFIG_DIR}/.rosa-boundary-credential-candidate.XXXXXX") || {
        fail 'unable to create candidate file'
        return 1
    }
    chmod 0600 "${request_file}" "${candidate_file}"

    if ! printf '%s' "${payload}" | base64 --decode >"${request_file}" 2>/dev/null; then
        fail 'request is not valid base64'
        return 1
    fi
    unset payload

    # Exact keys prevent refresh, offline, and future unknown credential fields
    # from being copied into the task configuration.
    if ! jq --exit-status --slurp --arg op "${operation}" '
        def generation: type == "string" and length == 32 and test("^[0-9a-f]+$");
        length == 1 and (.[0] |
            type == "object" and
            (.access_token | type == "string" and length > 0) and
            (.url | type == "string") and
            (if $op == "renew" then
                keys == ["access_token", "expected_generation", "generation", "url"] and
                (.generation | generation) and (.expected_generation | generation) and
                .generation != .expected_generation
            else
                keys == ["access_token", "url"] or
                (keys == ["access_token", "generation", "url"] and (.generation | generation))
            end))
    ' "${request_file}" >/dev/null 2>&1; then
        fail 'request has invalid fields'
        return 1
    fi

    generation=$(jq --raw-output '.generation // empty' "${request_file}") || return 1
    expected=$(jq --raw-output '.expected_generation // empty' "${request_file}") || return 1
    # Reject line breaks before command substitution, which would otherwise
    # strip trailing newlines and validate a different URL than we install.
    request_url=$(jq --exit-status --raw-output '.url | select(test("[[:cntrl:]]") | not)' "${request_file}" 2>/dev/null) || {
        fail 'OCM URL is not approved'
        return 1
    }
    if ! is_approved_ocm_url "${request_url}"; then
        fail 'OCM URL is not approved'
        return 1
    fi

    if ! jq --compact-output \
        --arg client_id "${OCM_CLIENT_ID}" \
        --arg token_url "${OCM_TOKEN_URL}" \
        '{access_token, client_id: $client_id, scopes: ["openid"], token_url: $token_url, url}' \
        "${request_file}" >"${candidate_file}" 2>/dev/null; then
        fail 'unable to construct OCM configuration'
        return 1
    fi
    chmod 0600 "${candidate_file}"

    # Discard both streams because whoami output can contain personal data.
    # Remove task environment overrides so validation uses the candidate URL.
    if ! timeout --kill-after=2s 20s env \
        --unset=OCM_CONFIG \
        --unset=OCM_KEYRING \
        --unset=OCM_URL \
        HOME=/home/sre \
        XDG_CONFIG_HOME=/home/sre/.config \
        OCM_CONFIG="${candidate_file}" \
        ocm whoami >/dev/null 2>&1; then
        fail 'OCM credential validation failed'
        return 1
    fi

    # Compare under the same lock as clear and configure, after validation.
    lock_ocm || {
        fail 'unable to lock OCM configuration'
        return 1
    }
    if [[ "${operation}" == renew ]]; then
        current=''
        if [[ -f "${generation_file}" ]]; then
            IFS= read -r current <"${generation_file}" || current=''
        fi
        if [[ "${current}" != "${expected}" || ! -f "${OCM_CONFIG_DIR}/ocm.json" ]]; then
            fail 'OCM credential generation changed'
            return 1
        fi
    fi
    # Invalidate first: an interrupted commit must not leave an older
    # worker authorized to overwrite the new token.
    if ! rm --force -- "${generation_file}" ||
        ! mv --force --no-target-directory -- "${candidate_file}" "${OCM_CONFIG_DIR}/ocm.json"; then
        fail 'unable to install OCM configuration'
        return 1
    fi
    candidate_file=''
    if [[ -n "${generation}" ]] && ! printf '%s\n' "${generation}" >"${generation_file}"; then
        fail 'unable to record OCM credential generation'
        return 1
    fi
    printf '%s\n' "${SUCCESS_MARKER}"
)

# Clear all helper OCM state and any kubeconfig that may contain an OCM token.
clear_ocm() (
    umask 077
    lock_ocm || {
        fail 'unable to lock OCM configuration'
        return 1
    }
    rm --force -- \
        "${OCM_CONFIG_DIR}/.rosa-boundary-credential-generation" \
        "${OCM_CONFIG_DIR}/ocm.json" \
        "${OCM_CONFIG_DIR}"/.rosa-boundary-credential-request.* \
        "${OCM_CONFIG_DIR}"/.rosa-boundary-credential-candidate.* \
        "${KUBECONFIG_DIR}/config" || return 1
    # Advance the clear epoch so a Backplane login that started earlier is
    # rejected even if OCM credentials are configured again before it ends.
    printf '%s-%s\n' "${EPOCHREALTIME}" "${RANDOM}" >"${OCM_CONFIG_DIR}/${CLEAR_EPOCH_FILE}" || return 1
    printf '%s\n' "${SUCCESS_MARKER}"
)

# Print the last lines of Backplane's output behind a protocol marker so the
# CLI can show why login failed. Control and escape sequences are removed (before
# protocol markers are defused, so a split marker cannot be reassembled) and
# size is capped; the CLI sanitizes again. Backplane echoes the cluster ID, so
# its text must never be able to forge a protocol marker.
emit_backplane_message() {
    local line
    printf '%s\n' "$1" |
        sed -e 's/\x1b\[[0-9;?]*[A-Za-z]//g' -e 's/\r//g' |
        tr --delete '\000-\010\013-\037\177' |
        sed -e "s/${READY_MARKER}/[marker]/g" -e "s/${SUCCESS_MARKER}/[marker]/g" \
            -e "s/${GENERATIONS_MARKER}/[marker]/g" -e "s/${BACKPLANE_MESSAGE_MARKER}/[marker]/g" \
            -e '/^[[:space:]]*$/d' |
        tail --lines=3 |
        while IFS= read -r line; do
            printf '%s %s\n' "${BACKPLANE_MESSAGE_MARKER}" "${line:0:300}"
        done
}

# Current clear epoch; empty when no clear has run.
clear_epoch() {
    cat -- "${OCM_CONFIG_DIR}/${CLEAR_EPOCH_FILE}" 2>/dev/null || true
}

# A login that outlives a concurrent "clear ocm" must not leave an OCM-derived
# kubeconfig behind, even if credentials are configured again before it ends.
# Under the OCM lock, require the clear epoch seen at login start and the
# credentials to be unchanged by any clear; otherwise drop the kubeconfig and
# fail. Failing to take the lock also fails closed. configure and renew do not
# advance the epoch, so a renewal during login does not fail it.
login_still_valid() (
    if ! lock_ocm || [[ ! -s "${OCM_CONFIG_DIR}/ocm.json" ]] || [[ "$(clear_epoch)" != "$1" ]]; then
        rm --force -- "${KUBECONFIG_DIR}/config"
        return 1
    fi
)

# Initialize Backplane login for a cluster ID using the OCM
# configuration installed by configure_ocm. Backplane decides whether the ID is
# valid, and its last output lines are reported on failure.
login_backplane() {
    local cluster_id="$1" output rc

    # Read before checking credentials so a clear after this point is detected.
    LOGIN_START_EPOCH="$(clear_epoch)"
    LOGIN_SETTLED=0
    if [[ ! -s "${OCM_CONFIG_DIR}/ocm.json" ]]; then
        fail 'OCM credentials are not configured'
        return 1
    fi
    # Backplane writes the kubeconfig itself. If this helper is terminated
    # (hangup, interrupt, terminate) before the check below, still run it so a
    # kubeconfig written after a clear is removed. SIGKILL cannot be caught.
    trap 'exit 143' HUP INT TERM
    trap 'if ((LOGIN_SETTLED == 0)); then login_still_valid "${LOGIN_START_EPOCH}" || true; fi' EXIT
    # Bounded below the CLI transfer timeout so an unreachable Backplane fails
    # with a clear message instead of an opaque protocol timeout. "--" keeps an
    # ID that starts with "-" from being read as an option.
    output=$(env HOME=/home/sre XDG_CONFIG_HOME=/home/sre/.config \
        timeout --kill-after=5 "${BACKPLANE_LOGIN_TIMEOUT}" \
        ocm backplane login -- "${cluster_id}" 2>&1)
    rc=$?
    if ((rc != 0)); then
        # A failed login can still leave a partial kubeconfig behind.
        rm --force -- "${KUBECONFIG_DIR}/config"
        if ((rc == 124 || rc == 137)); then
            output="Backplane login timed out after ${BACKPLANE_LOGIN_TIMEOUT}s"
        fi
        LOGIN_SETTLED=1
        emit_backplane_message "${output}"
        fail 'Backplane login failed'
        return 1
    fi
    if ! login_still_valid "${LOGIN_START_EPOCH}"; then
        LOGIN_SETTLED=1
        fail 'OCM credentials were cleared during Backplane login'
        return 1
    fi
    LOGIN_SETTLED=1
    printf '%s\n' "${SUCCESS_MARKER}"
}

# Dispatch only the fixed provider operations supported by this helper.
main() {
    if [[ $# -eq 3 && "$1" == login && "$2" == backplane ]]; then
        login_backplane "$3"
        return
    fi
    if [[ $# -ne 2 || "$2" != ocm ]]; then
        fail 'usage: rosa-boundary-credential-helper configure|renew|clear ocm'
        return 2
    fi

    case "$1" in
    configure | renew)
        configure_ocm "$1"
        ;;
    clear)
        clear_ocm
        ;;
    *)
        fail 'usage: rosa-boundary-credential-helper configure|renew|clear ocm'
        return 2
        ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
