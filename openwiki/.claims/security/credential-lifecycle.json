    {
      "id": "claim_31731754d66040aba277d596cb2ba6e5",
      "statement": "aws_iam_role.sre_shared and aws_iam_role.lambda_invoker render an identical ABAC trust-policy shape across up to three Keycloak OIDC providers (primary always present, stage/prod statements included only when their issuer URL variable is non-empty): each statement grants sts:AssumeRoleWithWebIdentity plus sts:TagSession under a per-environment audience StringEquals condition, with optional aws:RequestTag/uuid allowlist and aws:RequestTag/roles group-enforcement conditions, each guarded by a plan-failing precondition when enabled without its required companion value (allowed_uuids or required_oidc_role).",
      "evidence": [
        {
          "resource": "repo://deploy/account/modules/shared-iam/lambda-invoker.tf#L1-L91",
          "version": "repo-lines-v1:sha256:9be7ea926a4e0839f00c6586ae3c3a554d200a662bab704cc5efcfc2d57d3692:"
        },
        {
          "resource": "repo://deploy/account/modules/shared-iam/oidc.tf#L9-L109",
          "version": "repo-lines-v1:sha256:998d1f1bad6b16fa195b89d102ee895ae5056c845b9951818a2891d10c061f1a:"
        }
