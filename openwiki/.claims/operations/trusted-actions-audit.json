    {
      "id": "claim_25c624e45b9848bf8f81d3738dc0b195",
      "statement": "In the regional Trusted Actions Terraform, a CloudWatch Logs subscription filter on the ECS app log group (/ecs/APP_NAME) matching lines with msg == \"audit record\" forwards those lines to a Kinesis Data Firehose delivery stream, which writes them into that same region's own S3 app bucket under the audit-logs/ prefix, with delivery errors written to an audit-logs-errors/ prefix in the same bucket and Firehose's own operational errors logged to a dedicated /aws/kinesisfirehose/APP_NAME-audit-logs CloudWatch log group.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/terraform/regional/audit_logs.tf",
          "version": "repo-file-v1:sha256:f23a3ddbb60b4f776d087e5a0fc1e0475940dcc844790db70e22b24b36aa5fdb"
        },
