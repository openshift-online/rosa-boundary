# Build context exclusions for rosa-boundary container image.
# Keep the build context minimal — only files needed by the Containerfile.

# Version control
.git/

# Tests (not needed in container)
tests/

# Lambda functions (deployed separately via Terraform)
lambda/

# Terraform and deployment configs
deploy/
*.tf
*.tfstate*
.terraform/

# Documentation
docs/
*.md
!skel/**/*.md

# Boundary Go CLI source (built separately, not part of container image)
cmd/
internal/
go.mod
go.sum
bin/

# Only the nested Trusted Actions CLI build inputs are needed. Re-admit these
# explicitly after the Go exclusions above; never copy its deployment/config
# files, local credentials, release artifacts or the separate server entrypoint.
components/**
!components/trusted-actions/
components/trusted-actions/**
!components/trusted-actions/go.mod
!components/trusted-actions/go.sum
!components/trusted-actions/VERSION
!components/trusted-actions/cmd/
components/trusted-actions/cmd/**
!components/trusted-actions/cmd/rta/
components/trusted-actions/cmd/rta/**
!components/trusted-actions/cmd/rta/*.go
!components/trusted-actions/internal/
!components/trusted-actions/internal/**

# Python virtual environments
.venv/
__pycache__/

# CI/CD configuration
.github/
.tekton/
.pre-commit-config.yaml

# Security findings
adversary-findings.*

# Editor and tool configs
.claude/worktrees/
.env
.env.example
renovate.json

# Scripts (not part of container image)
scripts/
