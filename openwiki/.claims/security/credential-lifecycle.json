    },
    {
      "id": "claim_8a10ffd152ac404387a65d51f267e022",
      "statement": "A separate content_replication IAM role exists unconditionally, independent of audit replication, with a service-only unconditioned s3.amazonaws.com trust policy deliberately mirroring the existing audit replication role's trust shape; neither content-publishing.tf role has any permission attached in that file, so a publisher or replication role is assumable immediately but grants no content access until a later, separate regional change adds the grant.",
      "evidence": [
        {
          "resource": "repo://deploy/account/modules/shared-iam/content-publishing.tf#L1-L16",
          "version": "repo-lines-v1:sha256:e1cb5573fc7ce43964404b061064648b0e8b2e880f4d9df8ebed950146f4424a:"
