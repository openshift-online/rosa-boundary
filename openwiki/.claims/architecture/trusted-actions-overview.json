    {
      "id": "claim_95e1683a206540f3911a68801350c42e",
      "statement": "Trusted Actions' API is OpenAPI-first: multi-file specs under openapi/ are bundled by 'make generate' (bundle-spec target, npm run bundle-spec) into api-spec.yaml, then oapi-codegen generates internal/openapi/api.go (ServerInterface, request/response types, chi routing) which must not be hand-edited; internal/handlers/api.go's APIHandler implements that generated ServerInterface with the actual business logic.",
      "evidence": [
