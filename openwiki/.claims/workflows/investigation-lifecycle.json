    {
      "id": "claim_c8e0b525c76a47cca4f3a36fa121a3dc",
      "statement": "Operator-submitted close requests and scheduled stale-investigation cleanup route through the same finalizer pipeline (seal, drain, copy, verify, publish, clean up) in lambda/reap-investigations/handler.py; the stale path alone carries no stop consent, since a scheduled job never stops a task on its own authority. Stopping a session's ECS task remains a separate CLI operation that never consults this finalizer, and the reaper performs its own authorization recheck rather than trusting the CLI's preview.",
      "evidence": [
        {
          "resource": "repo://internal/cmd/close_investigation.go#L74-L81",
          "version": "repo-lines-v1:sha256:a9387f65c96a616133e1451f9c5b9a97fe4ef230622f2438a6e5276253057e1a:"
        },
