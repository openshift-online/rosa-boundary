    {
      "id": "claim_70cbf6803ceb469a9ff9a95f89aab9b9",
      "statement": "The Trusted Actions OpenAPI document declares a single global security scheme, ocm_jwt, an HTTP bearer JWT validated against the Red Hat SSO JWKS endpoint with caller identity taken from the username claim (falling back to preferred_username); the /health endpoint is served outside the OpenAPI-defined contract directly by cmd/server/main.go and is explicitly marked public to the OCM authentication handler.",
      "evidence": [
        {
          "resource": "repo://components/trusted-actions/cmd/server/main.go#L367-L412",
          "version": "repo-lines-v1:sha256:dc8069c7477ef1fc82d5e4e67e6178fb48036427b1bb345449ebae217d727fd6:"
